# MongoDB Configuration
# For local development:
MONGODB_URI=mongodb://localhost:27017
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB_NAME=sentiment_intelligence

# Server Configuration
PORT=3001

# Ollama Configuration (local LLM for sentiment analysis)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Rate Limiting (IP-based scraping limits)
# Set SCRAPE_LIMIT_PER_IP=0 to disable rate limiting for internal/white-label deployments
SCRAPE_LIMIT_PER_IP=5
SCRAPE_WINDOW_MS=86400000
WHITELIST_IPS=127.0.0.1,::1
